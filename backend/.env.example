# ─── Server ─────────────────────────────────────────────────────────────────
PORT=4000
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:4000"

# ─── Database (PostgreSQL) ──────────────────────────────────────────────────
# Local Postgres: same value for both. Neon/hosted Postgres: DATABASE_URL is
# the pooled connection string, DATABASE_URL_UNPOOLED is the direct one
# (Prisma migrations need the direct connection).
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/baskhuji_dev"
DATABASE_URL_UNPOOLED="postgresql://postgres:PASSWORD@localhost:5432/baskhuji_dev"

# ─── Auth ───────────────────────────────────────────────────────────────────
# Any long random string — used to sign/verify login JWTs.
AUTH_SECRET="replace-with-a-long-random-string"

# ─── Gemini API (Google AI Studio — free tier, no billing required) ────────
# Get one at https://aistudio.google.com/apikey
# Powers: agreement clause drafting, dispute evidence analysis, message
# flagging, match-score explanations. All 4 fall back gracefully if missing.
GEMINI_API_KEY="your-gemini-api-key-here"

# ─── Gmail (agreement delivery, receipts, dispute & expiry notifications) ──
# GMAIL_APP_PASSWORD is a 16-character Gmail "app password", not your normal
# password — generate one at https://myaccount.google.com/apppasswords
GMAIL_EMAIL="your-gmail-address@gmail.com"
GMAIL_APP_PASSWORD="your-gmail-app-password"

# ─── SSLCOMMERZ Sandbox (rent payments via bKash, Nagad, Rocket, card) ─────
# Free sandbox account at https://developer.sslcommerz.com/
SSLCOMMERZ_STORE_ID="your-store-id"
SSLCOMMERZ_STORE_PASSWORD="your-store-password"

# ─── Cron (Vacancy & Agreement Expiry Notification System) ─────────────────
# Any long random string — required header (x-cron-secret) to trigger
# POST /api/cron/reminders.
CRON_SECRET="replace-with-a-long-random-string"
